	<parameter name="start_date" class="java.util.Date"/>
	<parameter name="end_date" class="java.util.Date"/>
	<parameter name="sales_id" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    t.trx_number,
    t.created_at,
    u.username,
    c.customer_name,
    SUM(td.qty) AS kuantitas,
    t.grand_total
FROM trx t
LEFT JOIN m_customer c ON t.customer_id = c.id
LEFT JOIN m_user u ON t.sales_id = u.id
LEFT JOIN trx_detail td ON td.trx_id = t.id
WHERE 
    ($P{start_date} IS NULL OR $P{end_date} IS NULL 
        OR DATE(t.created_at) BETWEEN $P{start_date} AND $P{end_date})
AND 
    ($P{sales_id} IS NULL OR u.id = $P{sales_id})
GROUP BY t.trx_number, t.created_at, u.username, c.customer_name, t.grand_total
ORDER BY t.created_at DESC]]>
	</queryString>
