    <subDataset name="DetailProdukDataset" uuid="d466e53c-772c-4737-b3a2-8d1513508e09">
        <parameter name="trx_number" class="java.lang.String"/>
        <parameter name="GRAND_TOTAL" class="java.lang.String"/>
        <queryString>
			<![CDATA[SELECT
                td.id,
                p.code          AS 'Kode Produk',
                p.product_name  AS 'Nama Produk',
                td.qty          AS 'Qty',
                FORMAT(td.subprice, 0, 'id_ID') AS 'Harga Satuan',
                FORMAT(td.price,    0, 'id_ID') AS 'Subtotal'
            FROM trx_detail td
            INNER JOIN m_product p ON td.product_id = p.id
            INNER JOIN trx       t ON td.trx_id     = t.id
            WHERE t.trx_number = $P{trx_number}
            ORDER BY td.id]]>
        </queryString>
        <field name="id" class="java.lang.Integer"/>
        <field name="Kode Produk" class="java.lang.String"/>
        <field name="Nama Produk" class="java.lang.String"/>
        <field name="Qty" class="java.lang.Integer"/>
        <field name="Harga Satuan" class="java.lang.String"/>
        <field name="Subtotal" class="java.lang.String"/>
        <variable name="rowNumber" class="java.lang.Integer" calculation="Count">
            <variableExpression><![CDATA[$F{id}]]></variableExpression>
            <initialValueExpression><![CDATA[0]]></initialValueExpression>
        </variable>
    </subDataset>
    <parameter name="trx_number" class="java.lang.String"/>
    <queryString language="SQL">
		<![CDATA[SELECT
            t.trx_number                                    AS 'No. Transaksi',
            DATE_FORMAT(t.created_at, '%d-%m-%Y %H:%i')    AS 'Tanggal',

            u.username AS 'Username Sales',
            CASE
                WHEN u.username = 'budi_s' THEN 'Budi Santoso'
                WHEN u.username = 'rina_k' THEN 'Rina Kusuma'
                WHEN u.username = 'doni_p' THEN 'Doni Pratama'
                WHEN u.username = 'sari_m' THEN 'Sari Mulyani'
                ELSE 'Admin'
            END AS 'Nama Sales',

            c.customer_name  AS 'Nama Customer',
            c.phone_number   AS 'No. Telepon',
            c.address        AS 'Alamat',
            c.gender         AS 'Jenis Kelamin',

            FORMAT(t.grand_total, 0, 'id_ID') AS 'Total Pembayaran'

        FROM trx t
        INNER JOIN m_user     u ON t.sales_id    = u.id
        INNER JOIN m_customer c ON t.customer_id = c.id
        WHERE t.trx_number = $P{trx_number}
        LIMIT 1]]>
    </queryString>
    <field name="No. Transaksi" class="java.lang.String"/>
    <field name="Tanggal" class="java.lang.String"/>
    <field name="Username Sales" class="java.lang.String"/>
    <field name="Nama Sales" class="java.lang.String"/>
    <field name="Nama Customer" class="java.lang.String"/>
    <field name="No. Telepon" class="java.lang.String"/>
    <field name="Alamat" class="java.lang.String"/>
    <field name="Jenis Kelamin" class="java.lang.String"/>
    <field name="Total Pembayaran" class="java.lang.String"/>
